generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admin {
  id      Int     @id
  usuario usuario @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  curso   curso[]
}

model aprendiz {
  id               Int                @id
  usuario          usuario            @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  progreso_modulo  progreso_modulo[]
  resultado_examen resultado_examen[]
}

model carrito {
  id            Int             @id @default(autoincrement())
  usuario_id    Int?            @unique
  usuario       usuario?        @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  carrito_curso carrito_curso[]
}

model carrito_curso {
  id         Int      @id @default(autoincrement())
  carrito_id Int?
  curso_id   Int?
  carrito    carrito? @relation(fields: [carrito_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  curso      curso?   @relation(fields: [curso_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model curso {
  id             Int              @id @default(autoincrement())
  titulo         String           @db.VarChar(100)
  descripcion    String?
  precio         Decimal          @db.Decimal(10, 2)
  admin_id       Int?
  carrito_curso  carrito_curso[]
  admin          admin?           @relation(fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detalle_compra detalle_compra[]
  modulo         modulo[]
}

model detalle_compra {
  id             Int             @id @default(autoincrement())
  factura_id     Int?
  curso_id       Int?
  curso          curso?          @relation(fields: [curso_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  factura_compra factura_compra? @relation(fields: [factura_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model examen_modulo {
  id               Int                @id @default(autoincrement())
  modulo_id        Int?               @unique
  modulo           modulo?            @relation(fields: [modulo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resultado_examen resultado_examen[]
}

model factura_compra {
  id             Int              @id @default(autoincrement())
  fecha          DateTime?        @default(now()) @db.Timestamp(6)
  usuario_id     Int?
  detalle_compra detalle_compra[]
  usuario        usuario?         @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model modulo {
  id              Int               @id @default(autoincrement())
  titulo          String?           @db.VarChar(100)
  orden           Int?
  curso_id        Int?
  examen_modulo   examen_modulo?
  curso           curso?            @relation(fields: [curso_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  progreso_modulo progreso_modulo[]
  video           video[]
}

model progreso_modulo {
  id          Int       @id @default(autoincrement())
  aprendiz_id Int?
  modulo_id   Int?
  completado  Boolean?  @default(false)
  aprendiz    aprendiz? @relation(fields: [aprendiz_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modulo      modulo?   @relation(fields: [modulo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model resultado_examen {
  id            Int            @id @default(autoincrement())
  examen_id     Int?
  aprendiz_id   Int?
  aprobado      Boolean?
  comentario    String?
  aprendiz      aprendiz?      @relation(fields: [aprendiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  examen_modulo examen_modulo? @relation(fields: [examen_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model usuario {
  id              Int              @id @default(autoincrement())
  nombre_completo String           @db.VarChar(100)
  email           String           @unique @db.VarChar(100)
  direccion       String?          @db.VarChar(150)
  admin           admin?
  aprendiz        aprendiz?
  carrito         carrito?
  factura_compra  factura_compra[]
}

model video {
  id        Int     @id @default(autoincrement())
  titulo    String? @db.VarChar(100)
  url       String?
  duracion  Int?
  orden     Int?
  modulo_id Int?
  modulo    modulo? @relation(fields: [modulo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
